load("@contrib_rules_jvm//java:defs.bzl", "java_test_suite")

# gazelle:java_module_granularity module

java_test_suite(
    name = "withhelpers-tests",
    srcs = [
        "NotWorldWithHelpersTest.java",
        "withdirectory/AnotherTest.java",
        "withdirectory/Helper.java",
    ],
    runner = "junit5",
    runtime_deps = [
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
        "@maven//:org_junit_vintage_junit_vintage_engine",
    ],
    deps = [
        "//notmodule/src/main/java/com/example/hello/notworld",
        "//testmodule/src/main/java/com/example/hello/notworld/justhelpersinmodule",
        "//testmodule/src/test/java/com/example/hello/notworld/justhelpersinmodule:justhelpersinmodule-tests-test-lib",
        "@maven//:junit_junit",
        "@maven//:org_hamcrest_hamcrest_all",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)
